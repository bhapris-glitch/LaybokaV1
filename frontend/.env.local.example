```env
# ============================================================================
# Layboka AI — V1 Frontend
# Environment Variables
# ============================================================================
#
# File:
# frontend/.env.local.example
#
# IMPORTANT:
# - Copy this file to .env.local for local development.
# - Never commit .env.local to GitHub.
# - NEXT_PUBLIC_* values are exposed to the browser.
# - NEVER put OpenAI, Shopify, Stripe, MongoDB, or other private secrets here.
# ============================================================================


# ----------------------------------------------------------------------------
# BACKEND API
# ----------------------------------------------------------------------------
#
# Local development:
#
# NEXT_PUBLIC_API_URL=http://localhost:5000
#
# Production:
# Replace this with your actual Railway backend URL.
#

NEXT_PUBLIC_API_URL=https://your-railway-backend-domain.up.railway.app


# ----------------------------------------------------------------------------
# APPLICATION URL
# ----------------------------------------------------------------------------
#
# Local:
#
# NEXT_PUBLIC_APP_URL=http://localhost:3000
#
# Production:
# Replace with your actual Vercel/custom frontend domain.
#

NEXT_PUBLIC_APP_URL=http://localhost:3000


# ----------------------------------------------------------------------------
# SHOPIFY INSTALL
# ----------------------------------------------------------------------------
#
# The frontend does not need the Shopify API secret.
# Installation is started through the backend.
#

NEXT_PUBLIC_SHOPIFY_INSTALL_PATH=/v1/install


# ----------------------------------------------------------------------------
# V1 TRIAL
# ----------------------------------------------------------------------------

NEXT_PUBLIC_TRIAL_DAYS=5


# ----------------------------------------------------------------------------
# APPLICATION
# ----------------------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=Layboka AI

NEXT_PUBLIC_APP_VERSION=1.0.0
```
